{
  "name": "paper-book",
  "private": true,
  "version": "0.1.0",
  "description": "Open any PDF as a real book: page curl, scenes, ribbons and a watch. Portable desktop app.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "npm run format:check && npm run lint && npm run check && npm run test && npm run build",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "app:portable": "tauri build --no-bundle"
  },
  "dependencies": {
    "@fontsource/outfit": "5.0.13",
    "@tauri-apps/api": "^2.2.0",
    "pdfjs-dist": "4.10.38",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "1.49.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tauri-apps/cli": "^2.2.0",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^22.10.0",
    "@types/three": "0.170.0",
    "eslint": "^9.17.0",
    "eslint-plugin-svelte": "^2.46.1",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "prettier-plugin-svelte": "^3.3.2",
    "svelte": "~5.20.0",
    "svelte-check": "^4.1.1",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "~6.0.7",
    "vitest": "^3.0.9"
  }
}
